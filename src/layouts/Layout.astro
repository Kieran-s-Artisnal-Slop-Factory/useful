---
import '../styles/theme.css';
import '../styles/global.css';
import { href } from '../lib/paths';
import Navbar from '../components/Navbar.svelte';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
// Base-aware paths for the inline scripts / static links below (works whether
// the app is served at the root or under a sub-path like GitHub Pages).
const swPath = href('/sw.js');
const onboardingPath = href('/onboarding/');
const testModeKey = 'useful-test-mode';
---

<!doctype html>
<html lang="en" data-sw-path={swPath}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="useful — local-first app" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <title>{title} · useful</title>
    <script is:inline>
      // Apply the manual theme override before first paint to avoid a flash.
      // 'light'/'dark' pin the scheme; anything else follows the OS setting.
      try {
        const theme = localStorage.getItem('useful-theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.style.colorScheme = theme;
        }
      } catch {}
    </script>
  </head>
  <body>
    <script is:inline define:vars={{ testModeKey }}>
      // Test hook: fetched ONLY when the test-mode flag is set on this profile,
      // so a real user never downloads it. See src/lib/testMode.ts.
      try {
        if (localStorage.getItem(testModeKey) === '1') {
          import('../lib/testHook.ts').then((m) => m.installTestHook());
        }
      } catch {}
    </script>
    <Navbar client:load {currentPath} />
    <main class="page">
      <slot />
    </main>
    {
      import.meta.env.PROD ? (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
              // The base-aware SW path is on <html data-sw-path>; registering
              // it there also sets the worker's scope to the base.
              navigator.serviceWorker
                .register(document.documentElement.dataset.swPath)
                .catch(() => {});
            });
          }
        </script>
      ) : (
        <script is:inline>
          // Dev: the service worker must NOT run — it caches Vite's module
          // URLs and serves stale code after edits (blank pages). Unregister
          // any leftover registration and drop its caches.
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then((regs) => {
              for (const reg of regs) reg.unregister();
            });
            if (window.caches) {
              // Only ours: this page may share an origin with other apps (a
              // path-multiplexing gateway serves several under one host), and
              // dropping their caches is not this dev-teardown's business.
              caches.keys().then((keys) => keys.filter((k) => k.startsWith('useful-cache-')).forEach((k) => caches.delete(k)));
            }
          }
        </script>
      )
    }
  </body>
</html>
