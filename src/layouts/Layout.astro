---
import '../styles/theme.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { href } from '../lib/paths';
import Chrome from '../components/chrome/Chrome.svelte';
import NotificationEngine from '../components/chrome/NotificationEngine.svelte';
import OfflineSetup from '../components/chrome/OfflineSetup.svelte';

interface Props {
  title: string;
  /**
   * Drop the three persistent chrome islands: the sidebar, the notification
   * engine and the install offer. For a window that is a viewport onto
   * something rather than a place to work — today, the web playground's
   * popped-out preview. The engine especially: a second copy ticking in a
   * second window would raise every notification twice.
   */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const currentPath = Astro.url.pathname;
// Base-aware paths for the inline scripts / static links below (works whether
// the app is served at the root or under a sub-path like GitHub Pages).
const swPath = href('/sw.js');
---

<!doctype html>
<html lang="en" data-sw-path={swPath}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="useful — local-first app" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <title>{title} · useful</title>
    <ClientRouter />
    <script is:inline>
      // Apply the manual theme override and the persisted sidebar state before
      // first paint to avoid a flash. 'light'/'dark' pin the scheme; anything
      // else follows the OS setting. Both live as attributes on <html> — which
      // ClientRouter WIPES on every client-side navigation (swapRootAttributes
      // replaces the attribute set with the incoming document's) — so the same
      // routine re-runs on astro:after-swap. The listener survives swaps
      // because inline scripts execute once per full document load.
      (() => {
        const apply = () => {
          try {
            const theme = localStorage.getItem('useful-theme');
            document.documentElement.style.colorScheme =
              theme === 'light' || theme === 'dark' ? theme : '';
            if (localStorage.getItem('useful-sidebar-collapsed') === '1') {
              document.documentElement.dataset.sidebar = 'collapsed';
            } else {
              delete document.documentElement.dataset.sidebar;
            }
          } catch {}
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body class:list={{ bare }}>
    <script>
      // Test hook: the chunk is fetched ONLY when the test-mode flag is set on
      // this profile, so a real user never downloads it. See src/lib/testMode.ts.
      import { installTestHookIfEnabled } from '../lib/testMode';
      installTestHookIfEnabled();
    </script>
    {
      !bare && (
        <>
          <Chrome client:load transition:persist="chrome" {currentPath} />
          <NotificationEngine client:load transition:persist="engine" />
          <OfflineSetup client:load transition:persist="offline" />
        </>
      )
    }
    <main class:list={['page', { bare }]}>
      <slot />
    </main>
    {
      import.meta.env.PROD ? (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
              // The base-aware SW path is on <html data-sw-path>; registering
              // it there also sets the worker's scope to the base.
              navigator.serviceWorker
                .register(document.documentElement.dataset.swPath)
                .catch(() => {});
            });
          }
        </script>
      ) : (
        <script is:inline>
          // Dev: the service worker must NOT run — it caches Vite's module
          // URLs and serves stale code after edits (blank pages). Unregister
          // any leftover registration and drop its caches.
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then((regs) => {
              for (const reg of regs) reg.unregister();
            });
            if (window.caches) {
              // Only ours: this page may share an origin with other apps (a
              // path-multiplexing gateway serves several under one host), and
              // dropping their caches is not this dev-teardown's business.
              caches.keys().then((keys) => keys.filter((k) => k.startsWith('useful-cache-')).forEach((k) => caches.delete(k)));
            }
          }
        </script>
      )
    }
  </body>
</html>
